[
 {
  "n": 1,
  "start": 0.0,
  "end": 2.48,
  "text": "Господь говорит в Нагорной проповеди:"
 },
 {
  "n": 2,
  "start": 3.38,
  "end": 6.9,
  "text": "Ищите же прежде Царства Божия и правды Его,"
 },
 {
  "n": 3,
  "start": 7.8,
  "end": 11.2,
  "text": "и это всё приложится вам."
 },
 {
  "n": 4,
  "start": 12.1,
  "end": 16.1,
  "text": "Евангелие от Матфея, глава шестая, стих тридцать третий."
 },
 {
  "n": 5,
  "start": 17.0,
  "end": 22.12,
  "text": "В буре апостол Павел потерял корабль и груз, но Бог сохранил всех, кто плыл с ним."
 },
 {
  "n": 6,
  "start": 23.02,
  "end": 26.58,
  "text": "Каждый день, новое Слово. Подписывайтесь."
 }
]