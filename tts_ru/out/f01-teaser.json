[
 {
  "n": 1,
  "start": 0.0,
  "end": 3.2,
  "text": "Как юный пастух победил великана?"
 },
 {
  "n": 2,
  "start": 4.1,
  "end": 7.82,
  "text": "Голиаф из Гефа был ростом шести локтей и пяди."
 },
 {
  "n": 3,
  "start": 8.72,
  "end": 12.76,
  "text": "Весь Израиль боялся выйти против него."
 },
 {
  "n": 4,
  "start": 13.66,
  "end": 17.98,
  "text": "А Давид взял посох, пращу и пять гладких камней."
 },
 {
  "n": 5,
  "start": 18.88,
  "end": 22.6,
  "text": "А я иду против тебя во имя Господа Саваофа."
 },
 {
  "n": 6,
  "start": 23.5,
  "end": 26.5,
  "text": "Всё решил один камень, и вера."
 },
 {
  "n": 7,
  "start": 27.4,
  "end": 30.64,
  "text": "Вся история, в большом фильме."
 },
 {
  "n": 8,
  "start": 31.54,
  "end": 35.18,
  "text": "Ссылка на него, внизу экрана."
 }
]